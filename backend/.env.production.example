# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ─── PostgreSQL (Render managed — copy from Render dashboard) ───────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# ─── MongoDB Atlas (free cluster) ───────────────────────────────────────────
# Get from: MongoDB Atlas → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/aesis?retryWrites=true&w=majority

# ─── Upstash Redis ──────────────────────────────────────────────────────────
# Get from: Upstash console → Database → REST API → .env
REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_256bit_random_hex_64chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
BCRYPT_ROUNDS=12

# ─── Encryption (AES-256-GCM, PII at rest) ───────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64char_hex

# ─── AI Engine (Render internal URL — no public exposure needed) ─────────────
# Use Render private service URL if both services are on same Render account:
# https://docs.render.com/private-services
AI_ENGINE_URL=https://aesis-ai-engine.onrender.com
AI_ENGINE_API_KEY=replace_with_strong_random_key

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
# Get from: SendGrid → Settings → API Keys
SENDGRID_API_KEY=SG.replace_with_sendgrid_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=AESIS System

# ─── File Storage (AWS S3 or compatible) ─────────────────────────────────────
AWS_BUCKET=aesis-uploads
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace

# ─── Frontend (Vercel deployment URL) ────────────────────────────────────────
FRONTEND_URL=https://your-app.vercel.app

# ─── Sentry (optional error tracking) ───────────────────────────────────────
SENTRY_DSN=
