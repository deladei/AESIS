# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL (Prisma) ────────────────────────────────────────
# Local dev: plain Postgres.
# Prod (Supabase) uses the SESSION-mode pooler — port 5432 on the
# aws-*.pooler.supabase.com host, NOT 6543 (transaction mode can't run
# migrations) and NOT db.<ref>.supabase.co (IPv6-only). One URL serves both the
# app and `prisma migrate deploy`, so there is no DIRECT_URL.
DATABASE_URL=postgresql://aisystem_user:aisystem1234@localhost:5432/aisystem_db?schema=public

# ─── MongoDB ───────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/aesis

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_256bit_random_hex
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
BCRYPT_ROUNDS=12

# ─── Encryption (PII at rest — AES-256-GCM) ────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_64char_hex

# ─── AI Engine (FastAPI) ────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=replace_with_internal_api_key

# ─── Email (SMTP — Brevo, Mailjet, Resend, Gmail, …) ────────────
# Any SMTP provider works; the transport is generic. Brevo needs no domain of
# your own — verify a single sender address and use these:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SMTP_USER=<the login Brevo shows on its SMTP page, not your account email>
#   SMTP_PASS=<the SMTP key Brevo generates>
# EMAIL_FROM must be an address the provider has verified, or every send is
# rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Legacy single-provider path, kept so an existing SendGrid deployment keeps
# sending until SMTP_* is filled in. SMTP_* wins when both are set.
SENDGRID_API_KEY=SG.replace_with_sendgrid_key

# Gates System Admin self-registration on the public sign-up page. Unset means
# admin registration is REFUSED (fail closed), never ungated. Min 12 chars.
ADMIN_SETUP_CODE=
EMAIL_FROM=noreply@aesis.cs.edu
EMAIL_FROM_NAME=AESIS System

# ─── File Storage (AWS S3 — legacy logbook attachments) ─────────
AWS_BUCKET=aesis-uploads
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace

# ─── File Storage (Cloudinary — weekly entry attachments) ───────
# Optional: leave blank in dev/test. The entry-attachment upload route returns
# 503 until all three are set. Find them in the Cloudinary console dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Frontend ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Sign in with Google (optional) ────────────────────────────
# All three must be set together. Unset, the button is not rendered and the
# routes report "not configured", so the app behaves exactly as it did before.
# GOOGLE_REDIRECT_URI must match a redirect URI registered on the OAuth client
# BYTE FOR BYTE — Google compares the whole string, so a trailing slash or
# http-vs-https is a rejected login, not a warning. See docs/google-sign-in.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ─── Sentry ─────────────────────────────────────────────────────
SENTRY_DSN=
