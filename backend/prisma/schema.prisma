// AESIS — AI-Enhanced Student Internship Supervision System
// PostgreSQL schema via Prisma ORM
// CS Department Pilot — AY 2024/2025

generator client {
  provider = "prisma-client-js"
}

// In prod DATABASE_URL is Supabase's SESSION-mode pooler (Supavisor, port 5432,
// aws-*.pooler.supabase.com — the direct db.*.supabase.co host is IPv6-only and
// unreachable from Render). Session mode is deliberate: this is one long-lived
// Node process, not serverless, and unlike transaction mode (6543) it can run
// `prisma migrate deploy`. So no `directUrl` is needed — one URL for app and
// migrations, same as local dev.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  student
  academic_supervisor
  company_supervisor
  coordinator
  // Head of Department: coordinator powers plus final-grade release sign-off.
  // Not self-registerable; provisioned by an admin.
  hod
  admin
}

enum PlacementStatus {
  pending
  active
  completed
  withdrawn
  failed
  // A transfer closed this placement; the student continues elsewhere. Weeks
  // completed here still count toward the attachment minimum.
  transferred_out
  // "Any attachment not properly authorized will be cancelled" — a cancelled
  // placement's weeks do NOT count toward the minimum.
  cancelled
}

// Change-of-attachment request. The logbook rule: a student starts and
// finishes at one establishment; a change needs the university's written
// permission IN ADVANCE (authorization letter), else the attachment is
// cancelled. The attachment is continuous across an approved transfer — week
// numbering never resets.
enum TransferStatus {
  requested
  approved
  rejected
}

// Self-reported at registration. `other` covers anyone who does not identify
// as male/female; the field is nullable so seeded/legacy accounts are unaffected.
enum Gender {
  male
  female
  other
}

// The 16 administrative regions of Ghana (2019 demarcation). A student's
// internship placement sits in exactly one region; an academic supervisor is
// assigned to exactly one region and supervises every intern placed there.
enum Region {
  ahafo
  ashanti
  bono
  bono_east
  central
  eastern
  greater_accra
  north_east
  northern
  oti
  savannah
  upper_east
  upper_west
  volta
  western
  western_north
}

enum SubmissionStatus {
  draft
  submitted
  under_review
  approved
  flagged
}

enum AiAnalysisStatus {
  pending
  processing
  completed
  failed
}

enum RiskTier {
  low
  medium
  high
}

enum NotificationType {
  risk_alert
  feedback_received
  submission_reminder
  placement_approved
  placement_rejected
  escalation
  system
}

enum EscalationAction {
  check_in_scheduled
  escalated_to_coordinator
  dismissed
}

enum EscalationOutcome {
  site_visit_requested
  placement_transfer_initiated
  resolved
  pending
}

enum AuditAction {
  role_change
  data_export
  ai_override
  placement_status_change
  escalation_created
  escalation_resolved
  logbook_override
  component_scored
  grade_drafted
  grade_overridden
  grade_signed_off
  grade_released
}

// Identity verification of an industry supervisor RECORD (no account). The
// industry assessment is worth 30/100 marks and the contact details come from
// the student — verification restores the control the paper form's letterhead
// and signature provided. Only coordinator_approved / visit_confirmed records
// may be issued a final_assessment token (DB trigger enforces).
enum VerificationStatus {
  unverified
  coordinator_approved
  visit_confirmed
  rejected
}

// Classification of a supervisor's email domain against the webmail_domain
// lookup. A webmail address FLAGS for coordinator attention — never a hard
// block (many legitimate Ghanaian SMEs run on Gmail).
enum EmailDomainType {
  company
  webmail
  none
}

// Provenance of an industry record. `paper` = the coordinator keyed in a
// scanned form (scan is the evidence, entered_by named); `digital` = arrived
// through a tokenised link. A CHECK constraint makes the evidence mandatory.
enum RecordOrigin {
  digital
  paper
}

// What a single-use industry-supervisor token authorizes. weekly_comment needs
// a week_number; final_assessment may only be issued for a VERIFIED supervisor
// (DB trigger on assessment_token enforces — the teeth of the verification
// control).
enum TokenPurpose {
  weekly_comment
  final_assessment
}

// Lifecycle of a placement's aggregated final grade.
//   draft    -> components being entered; not yet aggregated/signed
//   approved -> aggregated & signed off by coordinator (HoD); NOT student-visible
//   released -> HoD released; the total becomes student-visible
enum GradeStatus {
  draft
  approved
  released
}

// ─────────────────────────────────────────────
// WEEKLY LOGBOOK PIPELINE (Postgres-only redesign)
// Three separated paths: write (must not fail),
// AI enrichment (fail-open), human workflow (may be slow).
// ─────────────────────────────────────────────

// Weekly entry state machine:
//   draft -> submitted -> acknowledged   (acknowledged is TERMINAL, LOCKS the week)
//   submitted -> returned -> draft       (return-to-draft increments version)
enum EntryStatus {
  draft
  submitted
  returned
  acknowledged
}

// Audit-trail event categories on entry_event. `transitioned` is a state-machine
// move; `created`/`edited` capture authoring; `scored` is a grade write.
enum EntryEventType {
  created
  edited
  transitioned
  scored
}

// Placement finalization, separate from weekly review:
//   active -> assessment_pending -> finalized
enum FinalizationStatus {
  active
  assessment_pending
  finalized
}

// Table-as-queue lifecycle for the fail-open enrichment worker.
enum EnrichmentStatus {
  pending
  processing
  succeeded
  failed
  abandoned
}

// Entry <-> learning-objective link state. AI-suggested links are `suggested`
// and DO NOT count toward progress until a human flips them to `confirmed`.
enum ObjectiveLinkStatus {
  suggested
  confirmed
}

// Provenance of an entry<->objective link. `ai` records that the enrichment
// path proposed it (advisory); `human` is a student/admin authored link.
enum ObjectiveLinkSource {
  human
  ai
}

// ─────────────────────────────────────────────
// REFERENCE TABLES
// ─────────────────────────────────────────────

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  users      User[]
  programmes AcademicProgramme[]

  @@map("departments")
}

model AcademicProgramme {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  users User[]

  @@map("academic_programmes")
}

model AcademicYear {
  id        String   @id @default(uuid())
  label     String   @unique // e.g. "2024/2025"
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  placements     Placement[]
  cohortConfigs  CohortConfig[]
  nonWorkingDays NonWorkingDay[]
  resources      Resource[]
  opportunities  InternshipOpportunity[]

  @@map("academic_years")
}

model CohortConfig {
  id                       String       @id @default(uuid())
  academicYearId           String       @map("academic_year_id")
  academicYear             AcademicYear @relation(fields: [academicYearId], references: [id])
  submissionDeadlineDay    Int          @default(5) @map("submission_deadline_day") // ISO weekday: 5 = Friday
  submissionDeadlineHour   Int          @default(23) @map("submission_deadline_hour")
  submissionDeadlineMinute Int          @default(59) @map("submission_deadline_minute")
  reminderDayOfWeek        Int          @default(1) @map("reminder_day_of_week") // 1 = Monday
  reminderHour             Int          @default(8) @map("reminder_hour")
  // LEGACY. Superseded by `durationWeeks`, which is the number every screen and
  // every rule now reads. Kept only as a fallback for cohorts created before
  // `durationWeeks` existed; nothing writes it and no API exposes it.
  totalWeeks               Int          @default(24) @map("total_weeks")
  // Per-week minimum attendance hours. Drives the intern dashboard's cumulative
  // hours target + shortfall flag. 0 = no minimum configured (never short).
  minWeeklyHours           Int          @default(0) @map("min_weekly_hours")
  // Logbook quality score (0–100) below which an intern's average flags them as
  // needing attention on the coordinator dashboard + Oversight. 0 disables the
  // low-score signal. Applied via ADD COLUMN IF NOT EXISTS (no migration folder)
  // to match this repo's established additive-column pattern.
  performanceThreshold     Int          @default(50) @map("performance_threshold")
  // Final-grade aggregation weights (percentage points; must sum to 100). Each
  // component's raw score is captured on a 0–100 scale and contributes
  // raw/100 * weight to the final /100 grade. Coordinator-configurable per cohort.
  weightIndustry           Int          @default(30) @map("weight_industry")
  weightUniversity         Int          @default(30) @map("weight_university")
  weightReport             Int          @default(30) @map("weight_report")
  weightLogbook            Int          @default(10) @map("weight_logbook")
  // Attachment length in weeks — THE single source of truth for "how long is
  // this programme". Coordinator-editable (see updateActiveCohortConfig); the
  // database only bounds it at >= 1 (CHECK duration_weeks >= 1). The old
  // >= 6 floor made a 5-week cohort unconfigurable at the database, which is
  // the wrong place for a departmental rule to live.
  durationWeeks            Int          @default(5) @map("duration_weeks")
  workingDays              Int[]        @default([1, 2, 3, 4, 5]) @map("working_days") // ISO dow
  entryEditWindowDays      Int          @default(2) @map("entry_edit_window_days")
  syncGraceDays            Int          @default(3) @map("sync_grace_days") // hard outer bound past placement end
  createdAt                DateTime     @default(now()) @map("created_at")

  @@unique([academicYearId])
  @@map("cohort_configs")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String             @map("password_hash")
  role                UserRole
  firstName           String             @map("first_name")
  lastName            String             @map("last_name")
  phone               String? // AES-256-GCM encrypted at app layer
  // Self-reported at registration. `gender` applies to every role; `indexNumber`
  // is the student's university index/matric number (unique, students only).
  gender              Gender?            @map("gender")
  indexNumber         String?            @unique @map("index_number")
  // Academic-supervisor identity, self-reported at registration and unique so
  // one staff record can't back two accounts: university staff ID + honorific.
  staffId             String?            @unique @map("staff_id")
  title               String?            @map("title")
  departmentId        String             @map("department_id")
  department          Department         @relation(fields: [departmentId], references: [id])
  programmeId         String?            @map("programme_id")
  programme           AcademicProgramme? @relation(fields: [programmeId], references: [id])
  isVerified          Boolean            @default(false) @map("is_verified")
  // For academic_supervisor only: the one region this supervisor covers.
  // Set by the coordinator; null until assigned. New interns in this region
  // are auto-balanced across all supervisors sharing it.
  supervisedRegion    Region?            @map("supervised_region")
  avatarUrl           String?            @map("avatar_url")
  // Year of study (100/200/300/400). Students only; NULL on every existing row,
  // and the UI renders "—" rather than guessing a level.
  academicLevel       Int?               @map("academic_level")
  verificationToken   String?            @map("verification_token")
  passwordResetToken  String?            @map("password_reset_token")
  passwordResetExpiry DateTime?          @map("password_reset_expiry")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  lastLoginAt         DateTime?          @map("last_login_at")

  // Relations by role
  studentPlacements           Placement[]          @relation("StudentPlacements")
  supervisorPlacements        Placement[]          @relation("AcademicSupervisorPlacements")
  companySupervisorPlacements Placement[]          @relation("CompanySupervisorPlacements")
  logbookSubmissions          LogbookSubmission[]
  supervisorFeedback          SupervisorFeedback[]
  notifications               Notification[]
  sentMessages                Message[]            @relation("MessageSender")
  riskScores                  StudentRiskScore[]
  escalationsCreated          RiskEscalation[]     @relation("EscalationCreatedBy")
  refreshTokens               RefreshToken[]
  auditLogs                   AuditLog[]
  visitSchedules              VisitSchedule[]      @relation("SupervisorVisits")

  // New weekly logbook pipeline
  entryEvents                 EntryEvent[]               @relation("EntryEventActor")
  placementAssessments        PlacementAssessment[]      @relation("PlacementAssessor")
  createdObjectives           LearningObjective[]        @relation("ObjectiveCreator")
  confirmedObjectiveLinks     EntryObjective[]           @relation("ObjectiveLinkConfirmer")
  uploadedAttachments         EntryAttachment[]          @relation("AttachmentUploader")
  gradesSignedOff             FinalGrade[]               @relation("GradeSignedOff")
  rosterUploads               StudentRoster[]            @relation("RosterUploader")
  rosterEntry                 StudentRoster?             @relation("RosterClaim")
  verifiedIndustrySupervisors IndustrySupervisor[]       @relation("IndustrySupervisorVerifier")
  createdAssessmentTokens     AssessmentToken[]          @relation("AssessmentTokenCreator")
  enteredIndustryAssessments  AssessmentIndustry[]       @relation("IndustryAssessmentEnteredBy")
  transferRequests            PlacementTransferRequest[] @relation("TransferStudent")
  transfersDecided            PlacementTransferRequest[] @relation("TransferDecider")
  weeklyCommentsAsStudent     IndustryWeeklyComment[]    @relation("WeeklyCommentStudent")
  weeklyCommentsEntered       IndustryWeeklyComment[]    @relation("WeeklyCommentEnteredBy")

  // SIWES daily logbook (Batch 1)
  siwesDailyEntries     DailyEntry[]   @relation("SiwesDailyEntries")
  // Weeks keyed on the student (student-relative week numbers, S87).
  logbookEntriesOwned   LogbookEntry[] @relation("StudentLogbookEntries")
  siwesAbsences         Absence[]      @relation("SiwesAbsences")
  siwesAbsencesRecorded Absence[]      @relation("SiwesAbsenceRecorder")

  // Dashboard domains
  tasksAssigned       Task[]                   @relation("TaskAssignee")
  tasksCreated        Task[]                   @relation("TaskCreator")
  approvalsRequested  ApprovalRequest[]        @relation("ApprovalRequester")
  approvalsAbout      ApprovalRequest[]        @relation("ApprovalSubject")
  approvalsDecided    ApprovalRequest[]        @relation("ApprovalDecider")
  resourcesCreated    Resource[]               @relation("ResourceCreator")
  opportunitiesPosted InternshipOpportunity[]  @relation("OpportunityPoster")
  applications        OpportunityApplication[] @relation("ApplicationStudent")
  applicationsDecided OpportunityApplication[] @relation("ApplicationDecider")
  applicationEvents   ApplicationEvent[]       @relation("ApplicationEventActor")
  documentsOwned      PlacementDocument[]      @relation("DocumentOwner")
  documentsUploaded   PlacementDocument[]      @relation("DocumentUploader")
  visitsCreated       VisitSchedule[]          @relation("VisitCreator")

  @@map("users")
}

// Pre-registration class list uploaded by the coordinator. When a student on
// the roster creates their account (matched by email or index number), the
// account links to its roster row and skips email verification — the system
// already knows them. Unlisted students can still register normally.
model StudentRoster {
  id           String    @id @default(uuid())
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  email        String    @unique
  indexNumber  String?   @unique @map("index_number")
  uploadedById String    @map("uploaded_by_id")
  uploadedBy   User      @relation("RosterUploader", fields: [uploadedById], references: [id])
  claimedById  String?   @unique @map("claimed_by_id")
  claimedBy    User?     @relation("RosterClaim", fields: [claimedById], references: [id])
  claimedAt    DateTime? @map("claimed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("student_roster")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// COMPANIES
// ─────────────────────────────────────────────

model Company {
  id           String    @id @default(uuid())
  name         String    @unique
  address      String? // AES-256-GCM encrypted at app layer
  industry     String?
  website      String?
  // Partner-company surface. A logo is optional and the UI falls back to an
  // initials monogram — a monogram is not fake data, an unlicensed logo is a
  // legal problem. Ranking is always by real placement count, never hand-ordered.
  logoUrl      String?   @map("logo_url")
  logoPublicId String?   @map("logo_public_id")
  description  String?
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone") // AES-256-GCM at the app layer
  isPartner    Boolean   @default(false) @map("is_partner")
  partnerSince DateTime? @map("partner_since")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  placements    Placement[]
  opportunities InternshipOpportunity[]

  @@index([isPartner])
  @@map("companies")
}

// ─────────────────────────────────────────────
// PLACEMENTS
// ─────────────────────────────────────────────

model Placement {
  id                    String             @id @default(uuid())
  studentId             String             @map("student_id")
  student               User               @relation("StudentPlacements", fields: [studentId], references: [id])
  academicSupervisorId  String?            @map("academic_supervisor_id")
  academicSupervisor    User?              @relation("AcademicSupervisorPlacements", fields: [academicSupervisorId], references: [id])
  companySupervisorId   String?            @map("company_supervisor_id")
  companySupervisor     User?              @relation("CompanySupervisorPlacements", fields: [companySupervisorId], references: [id])
  companyId             String?            @map("company_id")
  company               Company?           @relation(fields: [companyId], references: [id])
  academicYearId        String             @map("academic_year_id")
  academicYear          AcademicYear       @relation(fields: [academicYearId], references: [id])
  region                Region?            @map("region")
  startDate             DateTime?          @map("start_date")
  endDate               DateTime?          @map("end_date")
  placementStatus       PlacementStatus    @default(pending) @map("placement_status")
  // Finalization track (new logbook pipeline) — kept separate from placementStatus
  // so the existing approval/analytics flows are untouched.
  finalizationStatus    FinalizationStatus @default(active) @map("finalization_status")
  rejectionReason       String?            @map("rejection_reason")
  approvedAt            DateTime?          @map("approved_at")
  approvedBy            String?            @map("approved_by") // coordinator user id
  // Transfer support: exactly ONE current placement per student (partial unique
  // index in migration SQL — Prisma cannot model it). A transferred/cancelled
  // placement keeps its rows for history; supersedes links the chain.
  isCurrent             Boolean            @default(true) @map("is_current")
  supersedesPlacementId String?            @map("supersedes_placement_id")
  supersedes            Placement?         @relation("PlacementSupersedes", fields: [supersedesPlacementId], references: [id])
  supersededBy          Placement[]        @relation("PlacementSupersedes")
  // Manual coordinator "flag for attention". These columns ARE the flag's audit
  // record (who/when/why); cleared on un-flag. No FK on flaggedById by design.
  flaggedAt             DateTime?          @map("flagged_at")
  flagReason            String?            @map("flag_reason")
  flaggedById           String?            @map("flagged_by_id") // coordinator user id
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  logbookSubmissions LogbookSubmission[]
  riskScores         StudentRiskScore[]
  visitSchedules     VisitSchedule[]
  documents          PlacementDocument[]

  // New weekly logbook pipeline
  logbookEntries         LogbookEntry[]
  placementAssessment    PlacementAssessment?
  companyAttestation     CompanyAttestation?
  learningObjectives     LearningObjective[]
  finalGrade             FinalGrade?
  messages               Message[]
  industrySupervisors    IndustrySupervisor[]
  assessmentTokens       AssessmentToken[]
  industryAssessments    AssessmentIndustry[]
  industryWeeklyComments IndustryWeeklyComment[]
  transfersFrom          PlacementTransferRequest[] @relation("TransferFrom")
  transfersTo            PlacementTransferRequest[] @relation("TransferTo")

  // SIWES daily logbook (Batch 1)
  siwesDailyEntries DailyEntry[]
  siwesAbsences     Absence[]

  // Dashboard domains
  tasks               Task[]
  approvalRequests    ApprovalRequest[]
  sourceApplication   OpportunityApplication? @relation("ApplicationPlacement", fields: [sourceApplicationId], references: [id])
  sourceApplicationId String?                 @unique @map("source_application_id")

  @@map("placements")
}

// Two-way mentorship messaging, threaded per placement (the intern is the thread).
// Participants: the student, their academic supervisor, and admins. Every message
// fans out an in-app notification (+ socket push, + email to the student) to the
// other participants so a reply is never missed.
model Message {
  id          String    @id @default(uuid())
  placementId String    @map("placement_id")
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  senderId    String    @map("sender_id")
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  body        String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([placementId, createdAt])
  @@map("messages")
}

// ─────────────────────────────────────────────
// LOGBOOK
// ─────────────────────────────────────────────

model LogbookSubmission {
  id               String           @id @default(uuid())
  placementId      String           @map("placement_id")
  placement        Placement        @relation(fields: [placementId], references: [id])
  studentId        String           @map("student_id") // denormalised for query perf
  student          User             @relation(fields: [studentId], references: [id])
  weekNumber       Int              @map("week_number")
  mongoDocId       String?          @map("mongo_doc_id") // ref to full text in MongoDB
  submissionStatus SubmissionStatus @default(draft) @map("submission_status")
  aiAnalysisStatus AiAnalysisStatus @default(pending) @map("ai_analysis_status")
  submittedAt      DateTime?        @map("submitted_at")
  deadline         DateTime
  isLate           Boolean          @default(false) @map("is_late")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  analysis    LogbookAnalysis?
  feedback    SupervisorFeedback[]
  attachments LogbookAttachment[]

  @@unique([placementId, weekNumber])
  @@map("logbook_submissions")
}

model LogbookAttachment {
  id           String            @id @default(uuid())
  submissionId String            @map("submission_id")
  submission   LogbookSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileUrl      String            @map("file_url") // S3 / Cloudinary URL
  fileName     String            @map("file_name")
  fileSize     Int               @map("file_size") // bytes
  mimeType     String            @map("mime_type")
  uploadedAt   DateTime          @default(now()) @map("uploaded_at")

  @@map("logbook_attachments")
}

// ─────────────────────────────────────────────
// AI ANALYSIS
// ─────────────────────────────────────────────

model LogbookAnalysis {
  id           String            @id @default(uuid())
  submissionId String            @unique @map("submission_id")
  submission   LogbookSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Quality scoring (rubric: Task Depth 30%, Tech Vocab 25%, Reflection 25%, Temporal Consistency 20%)
  qualityScore             Decimal? @map("quality_score") @db.Decimal(5, 2) // 0.00–100.00
  taskDepthScore           Decimal? @map("task_depth_score") @db.Decimal(5, 2)
  techVocabScore           Decimal? @map("tech_vocab_score") @db.Decimal(5, 2)
  reflectionScore          Decimal? @map("reflection_score") @db.Decimal(5, 2)
  temporalConsistencyScore Decimal? @map("temporal_consistency_score") @db.Decimal(5, 2)

  // CS relevance
  relevanceScore     Decimal? @map("relevance_score") @db.Decimal(4, 3) // 0.000–1.000
  isRelevanceFlagged Boolean  @default(false) @map("is_relevance_flagged")

  // Plagiarism
  plagiarismSimilarity Decimal? @map("plagiarism_similarity") @db.Decimal(4, 3)
  isPlagiarismFlagged  Boolean  @default(false) @map("is_plagiarism_flagged")
  plagiarismMatchIds   String[] @map("plagiarism_match_ids") // submission IDs of matches

  // Authenticity
  authenticityFlag Boolean @default(false) @map("authenticity_flag")

  // Sentiment (from supervisor feedback, updated after feedback submission)
  sentimentPolarity Decimal? @map("sentiment_polarity") @db.Decimal(4, 3)
  sentimentClass    String?  @map("sentiment_class") // constructive/critical/supportive/frustrated/neutral/encouraging

  // Explainability
  shapValues        Json?   @map("shap_values")
  aiFeedbackSummary String? @map("ai_feedback_summary")

  computedAt DateTime? @map("computed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("logbook_analyses")
}

// ─────────────────────────────────────────────
// RISK SCORES
// ─────────────────────────────────────────────

model StudentRiskScore {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  student        User      @relation(fields: [studentId], references: [id])
  placementId    String    @map("placement_id")
  placement      Placement @relation(fields: [placementId], references: [id])
  riskScore      Decimal   @map("risk_score") @db.Decimal(4, 3) // 0.000–1.000
  riskTier       RiskTier  @map("risk_tier")
  previousTier   RiskTier? @map("previous_tier")
  topRiskFactors String[]  @map("top_risk_factors") // human-readable SHAP top-3
  shapValues     Json      @map("shap_values")
  computedAt     DateTime  @default(now()) @map("computed_at")

  escalations RiskEscalation[]

  @@map("student_risk_scores")
}

// ─────────────────────────────────────────────
// SUPERVISOR FEEDBACK
// ─────────────────────────────────────────────

model SupervisorFeedback {
  id           String            @id @default(uuid())
  submissionId String            @map("submission_id")
  submission   LogbookSubmission @relation(fields: [submissionId], references: [id])
  supervisorId String            @map("supervisor_id")
  supervisor   User              @relation(fields: [supervisorId], references: [id])
  feedbackText String            @map("feedback_text")
  rating       Int? // optional 1–5 structured rating
  submittedAt  DateTime          @default(now()) @map("submitted_at")

  @@map("supervisor_feedback")
}

// ─────────────────────────────────────────────
// RISK ESCALATIONS
// ─────────────────────────────────────────────

model RiskEscalation {
  id            String             @id @default(uuid())
  riskScoreId   String             @map("risk_score_id")
  riskScore     StudentRiskScore   @relation(fields: [riskScoreId], references: [id])
  createdById   String             @map("created_by_id") // supervisor who acted
  createdBy     User               @relation("EscalationCreatedBy", fields: [createdById], references: [id])
  action        EscalationAction   @map("action")
  dismissReason String?            @map("dismiss_reason")
  outcome       EscalationOutcome? @map("outcome")
  resolvedAt    DateTime?          @map("resolved_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("risk_escalations")
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false) @map("is_read")
  link      String? // deep link into the app
  metadata  Json? // contextual payload (e.g. studentId, submissionId)
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  @@map("notifications")
}

// ─────────────────────────────────────────────
// DOCUMENTS & FILES
// ─────────────────────────────────────────────

model PlacementDocument {
  id              String    @id @default(uuid())
  placementId     String    @map("placement_id")
  placement       Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  docType         String    @map("doc_type") // placement_letter | acceptance_letter | internship_agreement | learning_plan | weekly_report | cv | final_report | other
  title           String?
  fileUrl         String    @map("file_url")
  fileName        String    @map("file_name")
  fileSize        Int       @map("file_size")
  mimeType        String    @map("mime_type")
  storagePublicId String?   @map("storage_public_id")
  // Who it belongs to and who put it there. Backfilled from the placement's
  // student for existing rows; kept nullable rather than tightened afterwards.
  ownerUserId     String?   @map("owner_user_id")
  owner           User?     @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  uploadedById    String?   @map("uploaded_by_id")
  uploadedBy      User?     @relation("DocumentUploader", fields: [uploadedById], references: [id])
  // Documents are evidence: they are hidden, never destroyed.
  deletedAt       DateTime? @map("deleted_at")
  uploadedAt      DateTime  @default(now()) @map("uploaded_at")

  applications OpportunityApplication[] @relation("ApplicationCv")

  @@index([ownerUserId, uploadedAt])
  @@map("placement_documents")
}

// ─────────────────────────────────────────────
// VISIT SCHEDULES
// ─────────────────────────────────────────────

model VisitSchedule {
  id              String    @id @default(uuid())
  placementId     String    @map("placement_id")
  placement       Placement @relation(fields: [placementId], references: [id])
  supervisorId    String    @map("supervisor_id")
  supervisor      User      @relation("SupervisorVisits", fields: [supervisorId], references: [id])
  scheduledAt     DateTime  @map("scheduled_at")
  notes           String?
  completed       Boolean   @default(false)
  completedAt     DateTime? @map("completed_at")
  // Everything below is what turns an unused table into a review appointment.
  visitType       VisitType @default(review_meeting) @map("visit_type")
  durationMinutes Int       @default(60) @map("duration_minutes")
  location        String?
  outcomeNote     String?   @map("outcome_note")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  createdById     String?   @map("created_by_id")
  createdBy       User?     @relation("VisitCreator", fields: [createdById], references: [id])
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([supervisorId, scheduledAt])
  @@index([placementId, scheduledAt])
  @@map("visit_schedules")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String      @map("entity_type") // e.g. "placement", "logbook_submission"
  entityId   String      @map("entity_id")
  metadata   Json? // before/after state or relevant context
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// CHATBOT SESSION (lightweight — full history in Redis/MongoDB)
// ─────────────────────────────────────────────

model ChatSession {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  mongoSessionId String   @map("mongo_session_id") // full message history in MongoDB
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("chat_sessions")
}

// ─────────────────────────────────────────────
// WEEKLY LOGBOOK PIPELINE — TABLES
// All FK into existing users/placements. PostgreSQL only (no Mongo).
// Freeform fields use jsonb.
// ─────────────────────────────────────────────

// One weekly entry per placement+week. The unique constraint is the
// idempotency anchor for the write path.
model LogbookEntry {
  id          String      @id @default(uuid())
  placementId String      @map("placement_id")
  placement   Placement   @relation(fields: [placementId], references: [id])
  // Denormalised from placement so the week can be keyed on the STUDENT.
  // weekNumber is student-relative (anchored on the supersedes-chain start, see
  // siwes.calendar.ts::weekNumberFor), so a transferred student's logbook stays
  // continuous instead of restarting at 1 under the new placement.
  studentId   String      @map("student_id")
  student     User        @relation("StudentLogbookEntries", fields: [studentId], references: [id])
  weekNumber  Int         @map("week_number")
  periodStart DateTime    @map("period_start") @db.Date
  periodEnd   DateTime    @map("period_end") @db.Date
  status      EntryStatus @default(draft)
  hoursLogged Decimal?    @map("hours_logged") @db.Decimal(5, 2)
  version     Int         @default(1)
  submittedAt DateTime?   @map("submitted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  activities     EntryActivity[]
  reflection     EntryReflection?
  events         EntryEvent[]
  assessments    AiAssessment[]
  enrichmentJobs EnrichmentQueue[]
  objectiveLinks EntryObjective[]
  attachments    EntryAttachment[]
  days           DailyEntry[]

  @@unique([studentId, weekNumber])
  @@index([placementId])
  @@index([status])
  @@map("logbook_entry")
}

model EntryActivity {
  id             String       @id @default(uuid())
  entryId        String       @map("entry_id")
  entry          LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  activityDate   DateTime     @map("activity_date") @db.Date
  description    String
  competencyTags String[]     @map("competency_tags")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([entryId])
  @@map("entry_activity")
}

// Per-day submission state within a week. The DAY is the unit the student
// submits (Mon–Fri); the WEEK (LogbookEntry) stays the unit the supervisor
// reviews/acknowledges and grades. Lives on DailyEntry since S87 — the old
// `entry_days` table was absorbed there so a day has ONE row, not one for its
// status and another for its content.
enum DayStatus {
  draft
  submitted
}

model EntryReflection {
  entryId           String       @id @map("entry_id")
  entry             LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  learning          String
  challenges        String
  supervisorVisible Boolean      @default(true) @map("supervisor_visible")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@map("entry_reflection")
}

// Image / document evidence attached to a weekly entry. Files live in
// Cloudinary; `publicId` is its handle for deletion. Only attachable while the
// entry is editable (draft/returned) and only by the owning student — enforced
// in entries.service via assertPlacementAccess + the state machine.
enum AttachmentKind {
  image
  document
}

model EntryAttachment {
  id           String         @id @default(uuid())
  entryId      String         @map("entry_id")
  entry        LogbookEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  // The working day this file evidences. Null on rows uploaded before
  // day-level attachments existed (those were week-level evidence).
  dayDate      DateTime?      @map("day_date") @db.Date
  fileUrl      String         @map("file_url") // Cloudinary secure_url
  publicId     String         @map("public_id") // Cloudinary public_id, for deletion
  fileName     String         @map("file_name")
  fileSize     Int            @map("file_size") // bytes
  mimeType     String         @map("mime_type")
  kind         AttachmentKind
  uploadedById String         @map("uploaded_by_id")
  uploadedBy   User           @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime       @default(now()) @map("uploaded_at")

  @@index([entryId])
  @@map("entry_attachment")
}

// APPEND-ONLY audit log of every state transition. A DB trigger
// (see migration) rejects UPDATE/DELETE; the app only ever INSERTs.
// `score` is populated only when the weekly_binding_grades flag is on
// (recorded on the acknowledge transition).
model EntryEvent {
  id         String          @id @default(uuid())
  entryId    String          @map("entry_id")
  entry      LogbookEntry    @relation(fields: [entryId], references: [id])
  actorId    String          @map("actor_id")
  actor      User            @relation("EntryEventActor", fields: [actorId], references: [id])
  actorRole  UserRole?       @map("actor_role")
  eventType  EntryEventType? @map("event_type")
  // to_status is null for non-transition events (created/edited/scored).
  fromStatus EntryStatus?    @map("from_status")
  toStatus   EntryStatus?    @map("to_status")
  comment    String?
  score      Decimal?        @db.Decimal(5, 2)
  // Field-level snapshots (e.g. activities/reflection/hours) for edit events.
  before     Json?
  after      Json?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([entryId])
  @@map("entry_event")
}

// Advisory AI output. MUST NOT influence entry.status or any grade —
// enforced in code (worker only INSERTs here).
model AiAssessment {
  id            String       @id @default(uuid())
  entryId       String       @map("entry_id")
  entry         LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  modelName     String       @map("model_name")
  relevance     Decimal?     @db.Decimal(4, 3)
  summary       Json?        @db.JsonB
  // 6-dimension rubric breakdown (0-100 each, Zod-validated before write).
  quality       Json?        @db.JsonB
  // Similarity report vs other submitted entries. Redacted on student and
  // company-supervisor reads (match ids point at other students' entries).
  plagiarism    Json?        @db.JsonB
  // Groq draft for the SUPERVISOR to edit before sending (human-in-loop);
  // redacted on student and company-supervisor reads.
  feedbackDraft Json?        @map("feedback_draft") @db.JsonB
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([entryId])
  @@map("ai_assessment")
}

// The BINDING grade — one per placement. Set at finalization.
// `crossWeekSummary` holds the one-time cross-week AI summary (advisory).
model PlacementAssessment {
  id                   String    @id @default(uuid())
  placementId          String    @unique @map("placement_id")
  placement            Placement @relation(fields: [placementId], references: [id])
  academicSupervisorId String    @map("academic_supervisor_id")
  academicSupervisor   User      @relation("PlacementAssessor", fields: [academicSupervisorId], references: [id])
  grade                String
  narrative            String?
  // Structured end-of-placement evaluation form (criteria ratings 1–5 +
  // recommendation). Validated at the app layer; locked once finalized.
  evaluation           Json?     @db.JsonB
  crossWeekSummary     Json?     @map("cross_week_summary") @db.JsonB
  // Recorded reasons for any week finalized without acknowledgment (academic
  // supervisor waiver). Shape: [{ weekNumber, reason, waivedBy, waivedAt }].
  waivers              Json?     @db.JsonB
  finalizedAt          DateTime? @map("finalized_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("placement_assessment")
}

// Optional async company-supervisor attestation via signed, expiring,
// single-placement magic link — no account. Only the token HASH is stored.
model CompanyAttestation {
  id                 String    @id @default(uuid())
  placementId        String    @unique @map("placement_id")
  placement          Placement @relation(fields: [placementId], references: [id])
  confirmed          Boolean   @default(false)
  comment            String?
  magicLinkTokenHash String    @map("magic_link_token_hash")
  tokenExpiresAt     DateTime  @map("token_expires_at")
  attestedAt         DateTime? @map("attested_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("company_attestation")
}

// The unified, contested final grade for a placement. ONE row per placement.
// Four component raw scores (each 0–100, nullable until that assessor submits)
// are aggregated with cohort weights into a single /100 total. Confidentiality
// is enforced in the service/serializer layer (no RLS): the industry score is
// hidden from the student and the academic supervisor; the total is hidden from
// the student until released. Every write is audited.
model FinalGrade {
  id          String    @id @default(uuid())
  placementId String    @unique @map("placement_id")
  placement   Placement @relation(fields: [placementId], references: [id])

  // Raw component scores on a 0–100 scale. Null until the responsible assessor
  // submits. industry = tokenised company supervisor (or interim coordinator);
  // university/report/logbook = assigned academic supervisor.
  industryRaw   Float? @map("industry_raw")
  universityRaw Float? @map("university_raw")
  reportRaw     Float? @map("report_raw")
  logbookRaw    Float? @map("logbook_raw")

  // Weighted contributions (raw/100 * cohort weight). Recomputed on aggregate.
  industryWeighted   Float? @map("industry_weighted")
  universityWeighted Float? @map("university_weighted")
  reportWeighted     Float? @map("report_weighted")
  logbookWeighted    Float? @map("logbook_weighted")

  // Aggregate /100 (sum of weighted). coordinatorOverride, when set, replaces
  // the displayed total and REQUIRES overrideReason (recorded + audited).
  total               Float?  @map("total")
  coordinatorOverride Float?  @map("coordinator_override")
  overrideReason      String? @map("override_reason")

  status        GradeStatus @default(draft)
  signedOffById String?     @map("signed_off_by_id")
  signedOffBy   User?       @relation("GradeSignedOff", fields: [signedOffById], references: [id])
  signedOffAt   DateTime?   @map("signed_off_at")
  releasedAt    DateTime?   @map("released_at")

  // Batch B — tokenised company-supervisor industry-score channel (no account).
  // The raw magic-link token is handed out once; only its SHA-256 hash is stored.
  // industrySubmittedAt is the durable record of the company supervisor's
  // submission (there is no AuditLog row — they have no user id).
  industryTokenHash      String?   @map("industry_token_hash")
  industryTokenExpiresAt DateTime? @map("industry_token_expires_at")
  industrySubmittedAt    DateTime? @map("industry_submitted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("final_grades")
}

// Industry supervisors are RECORDS, not users — they act only via single-use
// tokenised links (assessment_token) handled server-side. Many per placement:
// a student rotating through units gets a supervisor record per unit. Their
// 30-mark assessment channel is gated on verification_status.
model IndustrySupervisor {
  id                 String             @id @default(uuid())
  placementId        String             @map("placement_id")
  placement          Placement          @relation(fields: [placementId], references: [id], onDelete: Cascade)
  name               String
  designation        String?
  departmentUnit     String?            @map("department_unit")
  phone              String?
  email              String?
  emailDomainType    EmailDomainType    @default(none) @map("email_domain_type")
  periodStart        DateTime?          @map("period_start") @db.Date
  periodEnd          DateTime?          @map("period_end") @db.Date
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  verifiedById       String?            @map("verified_by_id")
  verifiedBy         User?              @relation("IndustrySupervisorVerifier", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?          @map("verified_at")
  verificationNote   String?            @map("verification_note")
  createdAt          DateTime           @default(now()) @map("created_at")

  assessmentTokens    AssessmentToken[]
  industryAssessments AssessmentIndustry[]
  weeklyComments      IndustryWeeklyComment[]

  @@index([placementId])
  @@map("industry_supervisor")
}

// Single-use, time-bound, scoped tokens for industry-supervisor writes. Only
// the SHA-256 hash is stored — the raw token exists only in the link. A token
// is not a login: it may write exactly one record, scoped to its placement +
// supervisor + purpose (+ week for weekly comments).
model AssessmentToken {
  id                   String             @id @default(uuid())
  tokenHash            String             @unique @map("token_hash")
  placementId          String             @map("placement_id")
  placement            Placement          @relation(fields: [placementId], references: [id], onDelete: Cascade)
  industrySupervisorId String             @map("industry_supervisor_id")
  industrySupervisor   IndustrySupervisor @relation(fields: [industrySupervisorId], references: [id], onDelete: Cascade)
  purpose              TokenPurpose
  weekNumber           Int?               @map("week_number")
  expiresAt            DateTime           @map("expires_at")
  usedAt               DateTime?          @map("used_at")
  createdById          String?            @map("created_by_id")
  createdBy            User?              @relation("AssessmentTokenCreator", fields: [createdById], references: [id])
  createdAt            DateTime           @default(now()) @map("created_at")

  @@index([placementId])
  @@map("assessment_token")
}

// Change-of-attachment request; to_placement is created only on approval.
// new_company_address is the full address, not a P.O. box (logbook rule).
model PlacementTransferRequest {
  id                     String         @id @default(uuid())
  studentId              String         @map("student_id")
  student                User           @relation("TransferStudent", fields: [studentId], references: [id], onDelete: Cascade)
  fromPlacementId        String         @map("from_placement_id")
  fromPlacement          Placement      @relation("TransferFrom", fields: [fromPlacementId], references: [id])
  toPlacementId          String?        @map("to_placement_id")
  toPlacement            Placement?     @relation("TransferTo", fields: [toPlacementId], references: [id])
  newCompanyName         String         @map("new_company_name")
  newCompanyAddress      String         @map("new_company_address")
  reason                 String
  authorizationLetterUrl String?        @map("authorization_letter_url")
  status                 TransferStatus @default(requested)
  requestedAt            DateTime       @default(now()) @map("requested_at")
  decidedById            String?        @map("decided_by_id")
  decidedBy              User?          @relation("TransferDecider", fields: [decidedById], references: [id])
  decidedAt              DateTime?      @map("decided_at")
  decisionNote           String?        @map("decision_note")

  @@index([studentId])
  @@map("placement_transfer_request")
}

// CONFIDENTIAL: the Industrial Attachment Performance Evaluation Form, verbatim
// criteria and maxima (sum = 100). Sent "under confidential cover to the Head
// of Department" on paper — so staff-only here: the student AND the academic
// supervisor never read this table (sealed-envelope rule). Raw scores only;
// the /100 total scales to its cohort weight at aggregation, never stored
// scaled. DB CHECKs enforce the maxima, the total, and the evidence rule.
model AssessmentIndustry {
  id                          String             @id @default(uuid())
  placementId                 String             @map("placement_id")
  placement                   Placement          @relation(fields: [placementId], references: [id], onDelete: Cascade)
  industrySupervisorId        String             @map("industry_supervisor_id")
  industrySupervisor          IndustrySupervisor @relation(fields: [industrySupervisorId], references: [id])
  attendance                  Int // max 20 — the single heaviest criterion
  punctuality                 Int // max 15
  cooperation                 Int // max 10
  aptitude                    Int // max 15
  understanding               Int // max 20
  safety                      Int // max 10
  autonomy                    Int // max 10
  rawTotal                    Int                @map("raw_total") // = sum, CHECK-enforced
  additionalComments          String?            @map("additional_comments")
  reportingOfficerName        String             @map("reporting_officer_name")
  reportingOfficerDesignation String?            @map("reporting_officer_designation")
  companyHodName              String?            @map("company_hod_name")
  origin                      RecordOrigin       @default(digital)
  scanUrl                     String?            @map("scan_url")
  enteredById                 String?            @map("entered_by_id")
  enteredBy                   User?              @relation("IndustryAssessmentEnteredBy", fields: [enteredById], references: [id])
  tokenId                     String?            @map("token_id")
  submittedAt                 DateTime           @default(now()) @map("submitted_at")

  @@unique([placementId, industrySupervisorId])
  @@map("assessment_industry")
}

// FORMATIVE weekly comment from an industry supervisor — unlike
// assessment_industry, the STUDENT READS this (the logbook's weekly comment
// block, one per unit supervisor per week). Same two arrival paths and the
// same evidence rule, CHECK-enforced in migration SQL: paper needs
// scan_url + entered_by; digital needs token_id and NO staff enterer.
model IndustryWeeklyComment {
  id                   String             @id @default(uuid())
  placementId          String             @map("placement_id")
  placement            Placement          @relation(fields: [placementId], references: [id], onDelete: Cascade)
  studentId            String             @map("student_id")
  student              User               @relation("WeeklyCommentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  industrySupervisorId String             @map("industry_supervisor_id")
  industrySupervisor   IndustrySupervisor @relation(fields: [industrySupervisorId], references: [id])
  weekNumber           Int                @map("week_number")
  comment              String
  // Snapshot of the signer at comment time — the record must keep saying who
  // signed even if the supervisor record is later edited (unit rotation).
  supervisorName       String             @map("supervisor_name")
  departmentUnit       String?            @map("department_unit")
  commentDate          DateTime           @map("comment_date") @db.Date
  origin               RecordOrigin       @default(digital)
  scanUrl              String?            @map("scan_url")
  enteredById          String?            @map("entered_by_id")
  enteredBy            User?              @relation("WeeklyCommentEnteredBy", fields: [enteredById], references: [id])
  tokenId              String?            @map("token_id")
  createdAt            DateTime           @default(now()) @map("created_at")

  @@index([placementId, weekNumber])
  @@map("industry_weekly_comment")
}

// Coordinator-extendable webmail lookup (gmail, yahoo, …). A table rather than
// a hard-coded list so extending it needs no deploy. Classifies; never blocks.
model WebmailDomain {
  domain    String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("webmail_domain")
}

// Table-as-queue for the fail-open enrichment worker (no message broker).
model EnrichmentQueue {
  id          String           @id @default(uuid())
  entryId     String           @map("entry_id")
  entry       LogbookEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status      EnrichmentStatus @default(pending)
  attempts    Int              @default(0)
  maxAttempts Int              @default(5) @map("max_attempts")
  nextRunAt   DateTime         @default(now()) @map("next_run_at")
  lockedAt    DateTime?        @map("locked_at")
  lastError   String?          @map("last_error")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@map("enrichment_queue")
}

// Learning objective / competency defined per placement (the internship). The
// academic supervisor (or admin) defines them; entries map to one or more.
model LearningObjective {
  id          String    @id @default(uuid())
  placementId String    @map("placement_id")
  placement   Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdById String    @map("created_by_id")
  createdBy   User      @relation("ObjectiveCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  entryLinks EntryObjective[]

  @@index([placementId])
  @@map("learning_objective")
}

// Mapping of a weekly entry to a learning objective. `status` gates counting:
// an AI-suggested link is `suggested` and counts toward NOTHING until a human
// confirms it. `source` records provenance (human vs ai).
model EntryObjective {
  id            String              @id @default(uuid())
  entryId       String              @map("entry_id")
  entry         LogbookEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  objectiveId   String              @map("objective_id")
  objective     LearningObjective   @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  status        ObjectiveLinkStatus @default(confirmed)
  source        ObjectiveLinkSource @default(human)
  confirmedById String?             @map("confirmed_by_id")
  confirmedBy   User?               @relation("ObjectiveLinkConfirmer", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?           @map("confirmed_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  @@unique([entryId, objectiveId])
  @@index([objectiveId])
  @@index([entryId])
  @@map("entry_objective")
}

// ─────────────────────────────────────────────
// SIWES DAILY LOGBOOK (Batch 1)
// Models mirror the official UENR industrial-attachment instrument. Batch 0
// shipped IndustrySupervisor / AssessmentToken / WebmailDomain /
// AssessmentIndustry; the main-tree session owns industry_weekly_comment
// (Batch 2). These models extend that foundation, never duplicate it.
// ─────────────────────────────────────────────

enum AbsenceKind {
  sick
  permitted
  unexcused
}

// One calendar day of the SIWES logbook. Fields mirror the instrument's Weekly
// Progress Chart exactly (Description of Work Done / New Skills Learnt).
// created_at is server evidence (immutable via trigger); clientDraftedAt is the
// student's offline-draft CLAIM (forgeable; a nudge, never a control). Lateness
// is derived at read time from created_at — deliberately never stored.
// Consolidated S87: this is now THE day record. It hangs off the week
// (`entryId`), so the entries state machine, the append-only entry_event audit,
// enrichment and grading all reach daily content — previously they could not.
// `entry_days` was absorbed here: its `status`/`submitted_at` moved onto this
// model, and its stored `logged_late` flag was DROPPED rather than migrated,
// because lateness is derived from the immutable `created_at` (server evidence)
// and a stored flag is a second, forgeable answer to the same question.
model DailyEntry {
  id                String       @id @default(uuid())
  entryId           String       @map("entry_id")
  entry             LogbookEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  studentId         String       @map("student_id")
  student           User         @relation("SiwesDailyEntries", fields: [studentId], references: [id], onDelete: Cascade)
  placementId       String       @map("placement_id")
  placement         Placement    @relation(fields: [placementId], references: [id])
  weekNumber        Int          @map("week_number") // student-relative: never resets on transfer
  workDate          DateTime     @map("work_date") @db.Date
  // Nullable only for the transition: a day first touched through the weekly
  // flow exists as a status row while its content still lives in EntryActivity.
  // Phase 3 folds entry_activity in here and makes both required again. The
  // SIWES route's Zod schema requires them today regardless.
  descriptionOfWork String?      @map("description_of_work")
  newSkillsLearnt   String?      @map("new_skills_learnt")
  sketchUrl         String?      @map("sketch_url")
  status            DayStatus    @default(draft)
  submittedAt       DateTime?    @map("submitted_at")
  clientDraftedAt   DateTime?    @map("client_drafted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // A student works a given day once — this holds across a transfer chain,
  // which is why the key is the student and not the placement.
  @@unique([studentId, workDate])
  @@index([placementId])
  @@index([entryId])
  @@map("daily_entry")
}

// Cohort calendar: public holidays etc. A day with no entry is ambiguous
// (holiday? sick? no-show?) — this table + absence disambiguate so the
// missing-entry flag never fires on Independence Day.
model NonWorkingDay {
  id             String       @id @default(uuid())
  academicYearId String       @map("academic_year_id")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  day            DateTime     @db.Date
  label          String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([academicYearId, day])
  @@map("non_working_day")
}

// Per-person excused/unexcused days. Attendance is 20/100 of the industry
// assessment — a defensible record must distinguish sick leave from a no-show.
model Absence {
  id           String      @id @default(uuid())
  studentId    String      @map("student_id")
  student      User        @relation("SiwesAbsences", fields: [studentId], references: [id], onDelete: Cascade)
  placementId  String      @map("placement_id")
  placement    Placement   @relation(fields: [placementId], references: [id])
  absenceDate  DateTime    @map("absence_date") @db.Date
  kind         AbsenceKind
  reason       String?
  recordedById String?     @map("recorded_by_id")
  recordedBy   User?       @relation("SiwesAbsenceRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime    @default(now()) @map("created_at")

  @@unique([studentId, absenceDate])
  @@index([placementId])
  @@map("absence")
}

// ─────────────────────────────────────────────
// DASHBOARD DOMAINS
// Every model below has a named human producer and a real endpoint. This repo
// already carries tables nobody writes to (VisitSchedule was one until now);
// nothing here may join them.
// ─────────────────────────────────────────────

enum VisitType {
  site_visit
  review_meeting
  midterm_review
  final_review
  check_in
}

enum TaskCategory {
  report
  review
  admin
  meeting
  other
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

/// A to-do item. Producers: the student adds their own; a supervisor or
/// coordinator assigns one. "Tasks completed 18/28" is counted from these rows,
/// never stored as a counter.
model Task {
  id          String       @id @default(uuid())
  assigneeId  String       @map("assignee_id")
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String       @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  placementId String?      @map("placement_id")
  placement   Placement?   @relation(fields: [placementId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    TaskCategory @default(other)
  status      TaskStatus   @default(open)
  dueAt       DateTime?    @map("due_at")
  completedAt DateTime?    @map("completed_at")
  /// Deep link to what the task is about (a returned week, an approval).
  sourceType  String?      @map("source_type")
  sourceId    String?      @map("source_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([assigneeId, status, dueAt])
  @@index([placementId])
  @@map("task")
}

enum ApprovalKind {
  leave
  extension
  supervisor_change
  training_plan
}

enum ApprovalStatus {
  requested
  approved
  rejected
  withdrawn
}

/// A request that needs a human decision. One table with a `kind` rather than
/// four near-clones: all four share the same lifecycle. Change of COMPANY stays
/// in PlacementTransferRequest — its approval has structural side effects a
/// generic table cannot carry.
model ApprovalRequest {
  id              String         @id @default(uuid())
  kind            ApprovalKind
  status          ApprovalStatus @default(requested)
  requestedById   String         @map("requested_by_id")
  requestedBy     User           @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  /// Denormalised so a supervisor's queue is one indexed read, not a join chain.
  studentId       String         @map("student_id")
  student         User           @relation("ApprovalSubject", fields: [studentId], references: [id], onDelete: Cascade)
  placementId     String         @map("placement_id")
  placement       Placement      @relation(fields: [placementId], references: [id], onDelete: Cascade)
  title           String
  reason          String
  effectiveFrom   DateTime?      @map("effective_from") @db.Date
  effectiveTo     DateTime?      @map("effective_to") @db.Date
  attachmentUrl   String?        @map("attachment_url")
  payload         Json?
  decidedById     String?        @map("decided_by_id")
  decidedBy       User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decidedAt       DateTime?      @map("decided_at")
  decisionNote    String?        @map("decision_note")
  /// Idempotency anchor for the approval's side effect (Absence rows, endDate…).
  effectAppliedAt DateTime?      @map("effect_applied_at")
  requestedAt     DateTime       @default(now()) @map("requested_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([placementId, status])
  @@index([studentId])
  @@map("approval_request")
}

enum ResourceCategory {
  guideline
  template
  rubric
  policy
  form
  sample
  other
}

/// Guidelines, report templates, assessment rubrics. Producer: the coordinator.
model Resource {
  id             String           @id @default(uuid())
  title          String
  description    String?
  category       ResourceCategory @default(other)
  fileUrl        String?          @map("file_url")
  filePublicId   String?          @map("file_public_id")
  externalUrl    String?          @map("external_url")
  mimeType       String?          @map("mime_type")
  fileSize       Int?             @map("file_size")
  audienceRoles  UserRole[]       @map("audience_roles")
  academicYearId String?          @map("academic_year_id")
  academicYear   AcademicYear?    @relation(fields: [academicYearId], references: [id])
  isPublished    Boolean          @default(false) @map("is_published")
  sortOrder      Int              @default(0) @map("sort_order")
  createdById    String           @map("created_by_id")
  createdBy      User             @relation("ResourceCreator", fields: [createdById], references: [id])
  archivedAt     DateTime?        @map("archived_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([isPublished, category, sortOrder])
  @@map("resource")
}

enum OpportunityStatus {
  draft
  published
  closed
  filled
}

enum ApplicationStatus {
  pending
  under_review
  shortlisted
  offered
  accepted
  rejected
  withdrawn
}

enum ApplicationEventType {
  submitted
  status_changed
  withdrawn
  note_added
}

/// An internship posting. Producer: the coordinator (the industrial liaison).
/// Employer self-service needs an employer identity flow that does not exist.
model InternshipOpportunity {
  id               String            @id @default(uuid())
  companyId        String            @map("company_id")
  company          Company           @relation(fields: [companyId], references: [id])
  academicYearId   String            @map("academic_year_id")
  academicYear     AcademicYear      @relation(fields: [academicYearId], references: [id])
  postedById       String            @map("posted_by_id")
  postedBy         User              @relation("OpportunityPoster", fields: [postedById], references: [id])
  title            String
  description      String
  responsibilities String?
  requiredSkills   String[]          @map("required_skills")
  region           Region?
  location         String?
  slots            Int               @default(1)
  minAcademicLevel Int?              @map("min_academic_level")
  opensAt          DateTime?         @map("opens_at")
  closesAt         DateTime?         @map("closes_at")
  status           OpportunityStatus @default(draft)
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  applications OpportunityApplication[]

  @@index([status, closesAt])
  @@index([companyId])
  @@map("internship_opportunity")
}

/// A student's application. Accepting one creates the Placement through the
/// EXISTING placement path — the pipeline terminates in the current spine
/// rather than standing up a second one beside it.
model OpportunityApplication {
  id              String                @id @default(uuid())
  opportunityId   String                @map("opportunity_id")
  opportunity     InternshipOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  studentId       String                @map("student_id")
  student         User                  @relation("ApplicationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  statement       String?
  cvDocumentId    String?               @map("cv_document_id")
  cvDocument      PlacementDocument?    @relation("ApplicationCv", fields: [cvDocumentId], references: [id])
  status          ApplicationStatus     @default(pending)
  submittedAt     DateTime              @default(now()) @map("submitted_at")
  statusChangedAt DateTime              @default(now()) @map("status_changed_at")
  decidedById     String?               @map("decided_by_id")
  decidedBy       User?                 @relation("ApplicationDecider", fields: [decidedById], references: [id])
  decisionNote    String?               @map("decision_note")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  events    ApplicationEvent[]
  placement Placement?         @relation("ApplicationPlacement")

  @@unique([opportunityId, studentId])
  @@index([studentId, status])
  @@index([status, submittedAt])
  @@map("opportunity_application")
}

/// Append-only, mirroring entry_event. This is what makes the applications
/// trend a real query rather than a snapshot that forgets its own history.
model ApplicationEvent {
  id            String                 @id @default(uuid())
  applicationId String                 @map("application_id")
  application   OpportunityApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ApplicationEventType
  fromStatus    ApplicationStatus?     @map("from_status")
  toStatus      ApplicationStatus?     @map("to_status")
  actorId       String?                @map("actor_id")
  actor         User?                  @relation("ApplicationEventActor", fields: [actorId], references: [id])
  note          String?
  createdAt     DateTime               @default(now()) @map("created_at")

  @@index([applicationId])
  @@index([type, createdAt])
  @@map("application_event")
}
