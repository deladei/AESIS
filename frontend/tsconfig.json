{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared": ["../backend/src/shared/validation/index.ts"],
      "@shared/*": ["../backend/src/shared/validation/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../backend/src/shared/validation"],
  // The shared schemas are type-checked here, but their Jest suite belongs to
  // the backend and its runner types.
  "exclude": ["../backend/src/shared/validation/__tests__"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
