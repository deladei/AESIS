# ─── API & WebSocket ────────────────────────────────────────────────────────
# Set these in Vercel project settings → Environment Variables
# Do NOT commit real values — this file is a template only

# Backend Render URL (no trailing slash)
# NOTE: the live Render service answers at aesis.onrender.com (the
# aesis-backend.onrender.com hostname returns no-server / 404).
VITE_API_BASE_URL=https://aesis.onrender.com

# Same as API URL — Socket.io connects to the backend
VITE_SOCKET_URL=https://aesis.onrender.com
