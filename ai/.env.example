ENVIRONMENT=development
AI_API_KEY=dev_internal_key

# Same databases as Node backend
POSTGRES_DSN=postgresql://aisystem_user:aisystem1234@localhost:5432/aisystem_db
MONGO_URI=mongodb://localhost:27017/aesis
REDIS_URL=redis://localhost:6379/0

# Ollama — install free from https://ollama.com, then: ollama pull mistral
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding model (auto-downloads from HuggingFace on first run, ~90 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Thresholds
PLAGIARISM_THRESHOLD=0.35
RISK_HIGH_THRESHOLD=0.60
RISK_MEDIUM_THRESHOLD=0.30
