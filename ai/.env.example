ENVIRONMENT=development
AI_API_KEY=dev_internal_key

# Same databases as Node backend
POSTGRES_DSN=postgresql://aisystem_user:aisystem1234@localhost:5432/aisystem_db
MONGO_URI=mongodb://localhost:27017/aesis
REDIS_URL=redis://localhost:6379/0

# Chatbot LLM — Groq (OpenAI-compatible, free tier ~14.4k req/day).
# Get a key at https://console.groq.com/keys. Leave blank to force fallback responses.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# Embedding model (auto-downloads from HuggingFace on first run, ~90 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Thresholds
PLAGIARISM_THRESHOLD=0.35
RISK_HIGH_THRESHOLD=0.60
RISK_MEDIUM_THRESHOLD=0.30
